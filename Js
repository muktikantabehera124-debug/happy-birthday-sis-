let wifeyScale = 1;

// Function to open the gift box and reveal the letter
function openGift() {
  document.getElementById('giftBox').style.display = 'none';
  document.getElementById('content').style.display = 'block';
}

// Question 1 Logic: Tapping "My fav cousin" makes "Jiju's fav wifey" larger
function growWifeyBtn() {
  wifeyScale += 0.4;
  const wifeyBtn = document.getElementById('btn-wifey');
  wifeyBtn.style.transform = `scale(${wifeyScale})`;
}

// Function when Question 1 "Jiju's fav wifey" is selected
function answerQ1() {
  document.getElementById('q1').style.opacity = '0.5';
  document.getElementById('btn-fav-cousin').disabled = true;
  document.getElementById('btn-wifey').disabled = true;
  document.getElementById('q2').style.display = 'block';
}

// Question 2 Logic: Makes the second button move away when clicked or hovered
function moveButton() {
  const btn = document.getElementById('moving-btn');
  const x = Math.floor(Math.random() * 160) - 80;
  const y = Math.floor(Math.random() * 80) - 40;
  btn.style.transform = `translate(${x}px, ${y}px)`;
}

// Final Function after selecting option 1 in Question 2
function finishQuiz() {
  document.getElementById('final-message').style.display = 'block';
}
