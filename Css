body {
  margin: 0;
  padding: 20px;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  overflow-x: hidden;
}

/* Gift Box Styling */
.gift-container {
  cursor: pointer;
  transition: transform 0.3s ease;
}

.gift-container:hover {
  transform: scale(1.05);
}

.gift-box {
  font-size: 100px;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

.tap-text {
  font-size: 18px;
  font-weight: bold;
  color: #d63384;
}

/* Letter Section */
.content-section {
  display: none;
  max-width: 600px;
  width: 90%;
  background: rgba(255, 255, 255, 0.95);
  padding: 25px;
  border-radius: 20px;
  box-shadow: 0 10px 25px rgba(0,0,0,0.15);
  animation: fadeIn 1s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.letter {
  font-size: 16px;
  line-height: 1.6;
  color: #333;
  text-align: left;
  margin-bottom: 30px;
  white-space: pre-line;
}

/* Question Styles */
.question-block {
  margin-top: 25px;
  padding-top: 20px;
  border-top: 2px dashed #ffb6c1;
}

.question-title {
  font-size: 18px;
  font-weight: bold;
  color: #c2185b;
  margin-bottom: 15px;
}

.options {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 15px;
  flex-wrap: wrap;
  position: relative;
  min-height: 60px;
}

button {
  padding: 10px 20px;
  font-size: 15px;
  font-weight: bold;
  border: none;
  border-radius: 25px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-primary {
  background-color: #ff4081;
  color: white;
  z-index: 10;
}

.btn-secondary {
  background-color: #e0e0e0;
  color: #333;
}

#moving-btn {
  position: relative;
}
